<Window x:Class="Trinket.Studio.AttachmentPointEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set Attachment Point"
        Width="440" Height="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FAF7F2">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Click on the image where the cord should attach."
                   FontWeight="SemiBold" FontSize="14"
                   Margin="0,0,0,14" TextWrapping="Wrap" />

        <Border Grid.Row="1" Background="White" CornerRadius="8" ClipToBounds="True">
            <Grid x:Name="ImageContainer">
                <Image x:Name="PreviewImage"
                       Stretch="Uniform"
                       MouseLeftButtonDown="PreviewImage_MouseLeftButtonDown" />
                <Canvas x:Name="MarkerCanvas" IsHitTestVisible="False">
                    <Ellipse x:Name="AttachmentMarker"
                             Width="12" Height="12"
                             Fill="#E04F4F" Stroke="White" StrokeThickness="2"
                             Visibility="Collapsed" />
                </Canvas>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Padding="14,5" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button Content="Use This Charm" Padding="14,5" Click="Confirm_Click" />
        </StackPanel>
    </Grid>
</Window>