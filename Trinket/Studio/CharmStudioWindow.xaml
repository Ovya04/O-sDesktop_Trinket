<Window x:Class="Trinket.Studio.CharmStudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Charm Studio"
        Width="460" Height="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#FAF7F2">

    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="Charm Studio" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />

        <TabControl>
            <TabItem Header="Charms">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                    <StackPanel>
                        <TextBlock Text="Shape" FontSize="12" Foreground="#888" Margin="0,8,0,4" />
                        <ComboBox x:Name="CharmCombo" DisplayMemberPath="Name"
                                  SelectionChanged="CharmCombo_SelectionChanged" Margin="0,0,0,12" />

                        <TextBlock Text="Size" FontSize="12" Foreground="#888" Margin="0,0,0,4" />
                        <Slider x:Name="CharmSizeSlider" Minimum="30" Maximum="120"
                                ValueChanged="CharmSizeSlider_ValueChanged" Margin="0,0,0,12" />

                        <TextBlock Text="Initial Letter (used only when 'Initial' is selected)"
                                   FontSize="11" Foreground="#888" Margin="0,0,0,4" TextWrapping="Wrap" />
                        <TextBox x:Name="InitialLetterTextBox" Width="40" HorizontalAlignment="Left"
                                 MaxLength="1" TextChanged="InitialLetterTextBox_TextChanged" Margin="0,0,0,16" />

                        <Button Content="Import Custom Charm..." Padding="10,5"
                                HorizontalAlignment="Left" Click="ImportCharm_Click" Margin="0,0,0,8" />
                        <Button Content="Delete Selected Custom Charm" Padding="10,5"
                                HorizontalAlignment="Left" Click="DeleteCharm_Click" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Cord &amp; Beads">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                    <StackPanel>
                        <TextBlock Text="Cord Style" FontSize="12" Foreground="#888" Margin="0,8,0,4" />
                        <ComboBox x:Name="CordStyleCombo" SelectionChanged="CordStyleCombo_SelectionChanged" Margin="0,0,0,12">
                            <ComboBoxItem Content="Thread" />
                            <ComboBoxItem Content="Chain" />
                            <ComboBoxItem Content="Ribbon" />
                            <ComboBoxItem Content="Pearl String" />
                            <ComboBoxItem Content="Braided Cord" />
                            <ComboBoxItem Content="Vine" />
                        </ComboBox>

                        <TextBlock Text="Cord Color" FontSize="12" Foreground="#888" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Width="26" Height="26" Margin="0,0,6,0" Background="#AAAAAA" Tag="#FFAAAAAA" Click="ColorSwatch_Click" />
                            <Button Width="26" Height="26" Margin="0,0,6,0" Background="#F4A9B8" Tag="#FFF4A9B8" Click="ColorSwatch_Click" />
                            <Button Width="26" Height="26" Margin="0,0,6,0" Background="#A8C3A0" Tag="#FFA8C3A0" Click="ColorSwatch_Click" />
                            <Button Width="26" Height="26" Margin="0,0,6,0" Background="#E0B25C" Tag="#FFE0B25C" Click="ColorSwatch_Click" />
                            <Button Width="26" Height="26" Margin="0,0,10,0" Background="#B9A6D9" Tag="#FFB9A6D9" Click="ColorSwatch_Click" />
                            <Button Content="Custom..." Padding="8,2" Click="CustomColorButton_Click" />
                        </StackPanel>

                        <TextBlock Text="Cord Length" FontSize="12" Foreground="#888" Margin="0,0,0,4" />
                        <Slider x:Name="CordLengthSlider" Minimum="100" Maximum="400"
                                ValueChanged="CordLengthSlider_ValueChanged" Margin="0,0,0,16" />

                        <TextBlock Text="Beads" FontSize="12" Foreground="#888" Margin="0,0,0,4" />
                        <ComboBox x:Name="BeadsCombo" SelectionChanged="BeadsCombo_SelectionChanged">
                            <ComboBoxItem Content="None" />
                            <ComboBoxItem Content="Pearl" />
                            <ComboBoxItem Content="Round" />
                            <ComboBoxItem Content="Star" />
                            <ComboBoxItem Content="Heart" />
                        </ComboBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Position">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                    <StackPanel>
                        <TextBlock Text="Anchor Position" FontSize="12" Foreground="#888" Margin="0,8,0,4" />
                        <ComboBox x:Name="AnchorCombo" SelectionChanged="AnchorCombo_SelectionChanged" Margin="0,0,0,16">
                            <ComboBoxItem Content="Top Left" />
                            <ComboBoxItem Content="Top Center" />
                            <ComboBoxItem Content="Top Right" />
                        </ComboBox>

                        <TextBlock Text="Monitor" FontSize="12" Foreground="#888" Margin="0,0,0,4" />
                        <ComboBox x:Name="MonitorCombo" SelectionChanged="MonitorCombo_SelectionChanged" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Presets">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                    <StackPanel>
                        <TextBlock Text="Saved Trinkets" FontSize="12" Foreground="#888" Margin="0,8,0,4" />
                        <ComboBox x:Name="TrinketsCombo" DisplayMemberPath="Name" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Button Content="Apply" Padding="10,5" Margin="0,0,6,0" Click="ApplyTrinket_Click" />
                            <Button Content="Delete" Padding="10,5" Margin="0,0,6,0" Click="DeleteTrinket_Click" />
                            <Button Content="Save As New..." Padding="10,5" Click="SaveTrinket_Click" />
                        </StackPanel>

                        <Separator Margin="0,0,0,20" />

                        <TextBlock Text="Reset" FontSize="12" Foreground="#888" Margin="0,0,0,4" />
                        <Button Content="Reset to Defaults" Padding="10,5" HorizontalAlignment="Left"
                                Click="ResetDefaults_Click" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>